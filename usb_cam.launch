<?xml version="1.0"?>
<launch>
  <arg name="host" value="$(env HOSTNAME)" />

  <node ns="$(arg host)" name="camera" pkg="usb_cam" type="usb_cam_node">
    <param name="video_device" value="/dev/video0" />
    <param name="camera_info_url" value="$(dirname)/camera_info.yaml" />

    <param name="image_width" value="1920" />
    <param name="image_height" value="1080" />

    <param name="camera_name" value="head_camera" />
    <param name="camera_frame_id" value="$(arg host)" />
  </node>
</launch>
